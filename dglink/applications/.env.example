## Set portal name ## 

PORTAL_NAME="CRDC (Cancer Research Data Commons) merged portal (GDC, PDC, GC)"
# PORTAL_NAME="NF (Neurofibromatosis) Data Portal"


## set neo4j graph to use ##
# NEO4J_TARGET=/Users/buzgalbraith/workspace/dglink/dglink/applications/mcp/graph_nci_gc # main graph for hte NCI GC
# NEO4J_TARGET=/Users/buzgalbraith/workspace/dglink/dglink/applications/mcp/graph_poster # graph for poster examples 
NEO4J_TARGET=/Users/buzgalbraith/workspace/dglink/dglink/applications/mcp/graph_nf_data_portal # main nf data portal graph
NEO4J_TARGET=/Users/buzgalbraith/workspace/dglink/dglink/applications/mcp/graph_crdc_merged # graph with merged NCI GDC and GC results

## Overview page configuration ##
# Human-readable name for the graph whose stats the Overview page shows.
GRAPH_NAME="Merged CRDC graph (NCI GC · GDC · PDC)"

## MCL LLM configuration ##
FONT_SIZE=1.5
ABBREVIATED_RESPONSE=0
MAX_TURNS=50
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

OPENAI_API_KEY=${OPENAI_API_KEY}


## API configuration ##
NEO4J_URI=bolt://neo-4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
MCP_BACKEND_URL=http://mcp_backend:8000
SEMANTIC_SEARCH_BACKEND_URL=http://semantic_search_backend:8001
GENOMIC_INDEX_QUERY_BACKEND_URL=http://genomic_index_query_backend:8002

## Cross-tool navigation links (used by every frontend's header) ##
NAV_OVERVIEW_URL=http://localhost:5003/
NAV_CHAT_URL=http://localhost:5000/
NAV_QUERY_URL=http://localhost:5001/
NAV_SEQUENCE_URL=http://localhost:5002/

## Neo4j Browser web-view (linked from the Overview page) ##
# Auth is disabled in the neo4j image, so this opens with no login required.
NEO4J_BROWSER_URL=http://localhost:7474

## Public MCP endpoint (compose.crdc.yaml `mcp_http_server`) ##
# The URL an external MCP client connects to. Shown verbatim in the Overview page's
# "Add the MCP server to your own LLM" instructions, so point it at the public host
# when deploying (e.g. http://my-demo-host:8000/mcp/). Keep the trailing slash.
MCP_HTTP_URL=http://localhost:8000/mcp/
# Hosts the MCP server will answer to (DNS-rebinding protection). Must include the
# public hostname/IP you serve under, or requests are rejected. Comma-separated.
MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS allowlist — leave empty (deny) unless a browser-based MCP client needs it.
MCP_HTTP_ALLOW_ORIGINS=


## location of locally downloaded files from agent to reference ##
LOCAL_DATA_PATH="/Users/buzgalbraith/.data/"

## Feature flags ##
# When true, the Sequence Search tab is shown in every frontend's nav; when
# false it is hidden everywhere.
SHOW_SEQUENCE_SEARCH=false
# When true, the MCP Chat Assistant is shown (nav link, write-up, and the live
# "Run an MCP query" box on the Overview page); when false every reference to it
# is hidden. Set false for public deployments where the LLM-writes-Cypher chat
# interface should not be exposed. compose.crdc.yaml forces this off regardless.
SHOW_CHAT=true
## when true agent will be given access to locally downloaded portal files for further context.
USE_LOCAL_FILES=true

